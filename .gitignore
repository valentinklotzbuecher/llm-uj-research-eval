!_book/*_files/
!_book/*_files/**
!_book/site_libs/
!_book/site_libs/**

# Jupyter
/.jupyter_cache/
.ipynb_checkpoints/

# API keys and secrets
/key/
.Renviron
.env

# R session data and caches
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/

# Python
/.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Generated R binary files (generated from CSVs in results.qmd)
*.rds

# Account-specific cache (OpenAI file IDs)
cache/
._cache/

