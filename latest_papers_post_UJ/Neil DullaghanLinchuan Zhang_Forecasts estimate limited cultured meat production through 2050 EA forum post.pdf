}</style><style class="wpcode-css-snippet">/*Change line-height*/

.single-research-area #content-holder p, em {
	line-height: 1.6rem;
} 

.single-research-area #content-holder ul > li,
.single-research-area #content-holder ol > li
{
	line-height: 1.6rem !important;
} 

.single-research-area #content-holder h2,
.single-research-area #content-holder h3,
.single-research-area #content-holder h4 {
	scroll-margin-top: 6rem;
}


@media (max-width: 840px) {
	.single-research-area #content-holder p, em {
		line-height: 1.4rem;
	} 

	.single-research-area #content-holder ul > li,
	.single-research-area #content-holder ol > li
	{
		line-height: 1.4rem !important;
	} 
}


/*Sticky left menu*/
@media (min-width: 840px) {
	.single-research-area #content #toc-holder #sticky-nav {
		height: auto;
	}
}

.single-research-area #content #content-holder article {
	max-width: 722px;
}

.single-research-area #content #toc-holder #sticky-nav {
	top: 7rem;
	position: sticky;
	max-height: 100vh;
    overflow: auto;
}

.single-research-area #content #toc-holder #sticky-nav::-webkit-scrollbar {
	width: 0px;
}

.single-research-area #content #toc-holder #sticky-nav::-webkit-scrollbar-thumb {
	background: #49b9e52e;
}

.single-research-area #content #toc-holder #sticky-nav #toc {
	margin-bottom: 9rem;
}

.single-research-area #content #toc-holder #sticky-nav #toc li {
	margin-bottom: 1.1rem;
	padding-right: 5px;
}

.single-research-area #content #toc-holder #sticky-nav #toc a {
	transition: .3s;
}

.single-research-area #content #toc-holder #sticky-nav #toc a.active {
	color: #49b9e5;
}

 .single-research-area #content #toc-holder #sticky-nav #toc li ul {
		margin-left: 0px;
	}

.single-research-area #content #toc-holder #sticky-nav #toc li ul li ul {
	margin-left: 0px;
}

.single-research-area #content #toc-holder #sticky-nav .sticky-nav-title {
	display: none;
}


/*Acknowledgments*/

.single-research-area .acknowledgments-block .acknowledgments-content {
	display: grid;
    grid-template-columns: 0.5fr 1fr;
	place-items: center;
	gap: 20px;
    background: #49B9E514;
    border: 1px solid #49B9E57A;
    padding: 35px;
	margin-bottom: 40px;
}

.single-research-area .acknowledgments-block .acknowledgments-content .acknowledgments-text p {
	font-weight: 400;
	font-size: 20px;
	line-height: 30px;
	letter-spacing: 0%;
}

.single-research-area .acknowledgments-block .acknowledgments-content .acknowledgments-image p {
	margin-bottom: 0px;
}

.single-research-area .acknowledgments-block .acknowledgments-content .acknowledgments-image img {
	content:url("/wp-content/uploads/2025/02/rethinkpriorities-logo.webp");
	width: 234px;
	max-width: 350px;
}

.single-research-area .acknowledgments-block + p {
	font-weight: 700;
}

.single-research-area  #content-holder ol li sup {
	display: none;
}

@media (max-width: 840px) {
	.single-research-area .acknowledgments-block .acknowledgments-content {
		display: grid;
		grid-template-columns: 1fr;
		justify-content: center;
		padding: 20px;
	}
	
	.single-research-area .acknowledgments-block .acknowledgments-content .acknowledgments-text p {
		text-align: center;
		font-size: 16px;
		line-height: 30px;
	}
}

/*Acknowledgments*/


 @media (max-width: 840px) {
	 
	 .single-research-area  #content-holder {
		 overflow: auto;
	 }
	 
	 
	.single-research-area #content #toc-holder {
		display: block !important;
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 50px;
		padding: 0;
		opacity: 0;
		visibility: hidden;
		transition: .6s;
		z-index: 9;
		overflow: hidden;
		background: #fff;
	}
	
	.single-research-area #content #toc-holder #sticky-nav {
		position: relative;
		top: unset;
		max-height: unset;
	}
	
	.single-research-area #content #toc-holder #sticky-nav .sticky-nav-title {
		position: relative;
        display: flex;
        align-items: center;
        padding: 10px 30px;
        margin-bottom: 0;
        background: #49b9e5;
        color: #fff;
        min-height: 50px;
        font-size: 16px;
		text-transform: uppercase;
	}
	 
	 .single-research-area #content #toc-holder #sticky-nav .sticky-nav-title::after {
		content: '';
		position: absolute;
        top: 50%;
        right: 30px;
        transform: translateY(-50%);
		background-image: url('/wp-content/uploads/2025/01/icon-table.svg');
		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
		width: 35px;
        height: 35px;
		transition: .6s;
	}
	
	.single-research-area #content #toc-holder #sticky-nav #toc {
		position: relative;
        margin: 0;
        padding: 10px 30px;
        height: min-content;
        max-height: 250px;
        overflow: auto;
        background: #fff;
        z-index: 999;
	}
	
	.single-research-area #content #toc-holder #sticky-nav #toc li {
		margin-bottom: 0.5rem;
	}
	
	.single-research-area #content #toc-holder #sticky-nav #toc li a {
		font-size: .8rem;
	}
	 
	 
	/*Active Menu*/
	 
	 .single-research-area #content #toc-holder.active #sticky-nav .sticky-nav-title::after {
		 transform: translateY(-50%) rotate(-180deg);
	 }
	
	
	
	
}</style><link href="https://rethinkpriorities.org/wp-content/cache/autoptimize/css/autoptimize_single_a8337ded854a51c7e90290a036831e19.css" rel="stylesheet" type="text/css"> <script defer src="https://rethinkpriorities.org/wp-content/cache/autoptimize/js/autoptimize_single_a3cbf607b02f2cea87967b98d6f05a24.js"></script> <script defer src="data:text/javascript;base64,DQoJDQoJLy91cGRhdGUgc3R5bGUgZm9yIHNvcnQgZHJvcGRvd24gKHNlbGVjdCkNCgkNCiAgICBkb2N1bWVudC5hZGRFdmVudExpc3RlbmVyKCdmYWNldHdwLWxvYWRlZCcsIGZ1bmN0aW9uKCkgew0KICAgICAgZlV0aWwoJy5zb3J0LWhvbGRlciAuZmFjZXR3cC10eXBlLXNvcnQgc2VsZWN0JykuZlNlbGVjdCh7c2hvd1NlYXJjaDogZmFsc2V9KTsNCiAgICB9KTsNCgkNCg0KCQ0K"></script><style class="wpcode-css-snippet">/*research-holder dubble hero bug*/

.page-template-resources-landing .research-holder .facetwp-template .hero {
	display: none;
}

.page-template-resources-landing .research-holder .facetwp-template #research-sort {
	display: none;
}

/*research-holder collumns  bug*/

.page-template-resources-landing .research-holder .facetwp-template .columns em {
	display: flex;
    flex-wrap: wrap;
    margin-left: -0.4rem;
    margin-right: -0.4rem;
}

/*Search bar*/

#research-sort {
	padding-top: 0px !important;
    padding-bottom: 0px !important;
	margin-bottom: 70px;
}

#research-sort .container {
	padding: 20px;
    box-shadow: 0px 8px 24px -4px #919EAB1F;
    margin-top: -52px;
    z-index: 12;
    position: relative;
    background: #fff;
}

#research-sort .search-container  {
	padding: 0px;
}

#research-sort .selects-container {
	margin-left: 0;
    margin-right: 0;
	gap: 12px;
	display: grid;
    grid-template-columns: repeat(4, 1fr);
}

#research-sort .selects-container .column {
	padding-left: 0;
    padding-right: 0;
	width: 100%;
}

#research-sort .facetwp-type-search {
	width: 100%;
	margin-bottom: 16px;
}

#research-sort .facetwp-type-search .facetwp-input-wrap {
	width: 100%;
}

#research-sort .facetwp-type-search .facetwp-input-wrap input {
	width: 100%;
	min-height: 48px;
    background-color: #fff;
    border: 1px solid #D0D5DD;
    padding-left: 42px;
	box-shadow: 0px 1px 2px 0px #1018280D;
	border-radius: 1px;
	transition: .3s;
}

#research-sort .facetwp-type-search .facetwp-input-wrap input:hover {
	border: 1px solid #49B9E57A;
}

#research-sort .facetwp-type-search .facetwp-input-wrap input::placeholder {
	font-size: 16px;
	font-weight: 400;
}

#research-sort .facetwp-type-search .facetwp-input-wrap .facetwp-icon {
	left: 14px;
	right: unset;
}

#research-sort .facetwp-type-search .facetwp-input-wrap .facetwp-icon::before {
    display: inline-block;
    content: '';
    width: 25px;
    height: 100%;
    background: url('/wp-content/uploads/2025/01/icon-sort-search.svg');
    background-position: 0px 50%;
    background-size: 20px 20px;
    background-repeat: no-repeat;
}

#research-sort .facetwp-type-search .facetwp-input-wrap .facetwp-icon.f-loading::before {
    background: url(/wp-content/uploads/2025/01/loading.png);
    animation: spin .7s infinite linear;
    background-repeat: no-repeat;
    background-position: 2px 50%;
    background-size: 20px 20px;
}

/*Select*/

#research-sort .facetwp-type-fselect .fs-dropdown .fs-options div:first-child {
	display: none;
}

#research-sort .facetwp-type-fselect {
	width: 100%;
	margin-bottom: 0px;
}

#research-sort .facetwp-type-fselect .fs-wrap {
	width: 100%;
}

#research-sort .facetwp-type-fselect .fs-label-wrap {
	display: flex;
    align-items: center;
    min-height: 48px;
    border: 1px solid #D0D5DD;
    box-shadow: 0px 1px 2px 0px #1018280D;
	transition: .3s;
	cursor: pointer;
}

#research-sort .facetwp-type-fselect .fs-label-wrap:hover  {
	border: 1px solid #49B9E57A;
}

#research-sort .facetwp-type-fselect .fs-label-wrap .fs-label {
	font-size: 16px;
	font-weight: 400;
	padding-left: 14px;
}

#research-sort .facetwp-type-fselect .fs-label-wrap .fs-arrow {
	border: 1px solid #667085;
    border-width: 0 2px 2px 0;
    padding: 4px;
    transform: rotate(45deg);
    -webkit-transform: rotate(45deg);
    right: 21px;
    top: -6px;
	transition: .3s;
}

#research-sort .facetwp-type-fselect .fs-wrap.fs-open .fs-arrow {
	-webkit-transform: rotate(-135deg);
    top: -2px;
}

/*Select Reset Buttons*/

#research-sort .research_areas_container,
#research-sort .cause_area_container,
#research-sort .authors_container
{
	position: relative;
}


#research-sort .research_areas_container .facetwp-facet-research_areas_reset,
#research-sort .cause_area_container .facetwp-facet-cause_area_reset,
#research-sort .authors_container .facetwp-facet-author_reset
{
	position: absolute;
    right: 16px;
    top: 15px;
    width: 20px !important;
    height: 20px;
    background-color: #fff;
    margin-bottom: 0px;
	opacity: 1 !important;
}

#research-sort .research_areas_container .facetwp-type-reset button,
#research-sort .cause_area_container .facetwp-type-reset button,
#research-sort .authors_container .facetwp-type-reset button
{
    width: 100%;
    min-height: 100%;
    background: #ffffff00;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0px;
    cursor: pointer;
    line-height: 0.5px;
	border: none;
}

#research-sort .research_areas_container .facetwp-type-reset button::after,
#research-sort .cause_area_container .facetwp-type-reset button::after,
#research-sort .authors_container  .facetwp-type-reset button::after

{
	content: "";
	position: absolute;
	width: 100%;
	min-height: 100%;
	top: 1px;
	left: 0;
	background-image: url('/wp-content/uploads/2025/01/cross-svg.svg');,
	background-position: center;
	background-repeat: no-repeat;
	background-size: contain;
	background-size: 17px;
	transition: .3s;
}




/*Sort Filter*/

#research-sort .filters {
	gap: 12px;
}

#research-sort .facetwp-type-sort {
	width: 100%;
	margin-bottom: 0px;
	min-width: 270px;
}

#research-sort .facetwp-type-sort .fs-wrap {
	width: 100%;
}

#research-sort .facetwp-type-sort .fs-label-wrap  {
	display: flex;
    align-items: center;
	width: 100% !important;
	min-height: 48px;
	border: 1px solid #D0D5DD;
    box-shadow: 0px 1px 2px 0px #1018280D;
	transition: .3s;
	cursor: pointer;
}

#research-sort .facetwp-type-sort .fs-label-wrap:hover  {
	border: 1px solid #49B9E57A;
}

#research-sort .facetwp-type-sort .fs-label-wrap .fs-label {
    font-size: 16px;
    font-weight: 400;
	padding: 0px;
	padding-left: 14px;
}

#research-sort .fs-option-label {
    font-size: 16px;
    font-weight: 400;
}

#research-sort .facetwp-type-sort .fs-label-wrap .fs-arrow {
	border: 1px solid #667085;
    border-width: 0 2px 2px 0;
    padding: 4px;
    transform: rotate(45deg);
    -webkit-transform: rotate(45deg);
    right: 21px;
    top: -2px;
    transition: .3s;
}

#research-sort .facetwp-type-sort .fs-wrap.fs-open .fs-arrow {
	transform: rotate(-135deg);
	-webkit-transform: rotate(-135deg);
    top: -2px;
}



/*Sort Icons*/

#research-sort .sort {
	width: 100%;
	gap: 8px;
}

#research-sort .sort .grid {
	position: relative;
    background-image: url(/wp-content/uploads/2025/01/toggle-sort-2.svg);
    background-repeat: no-repeat;
    background-position: center;
	filter: brightness(0.1);
    width: 48px;
    min-height: 48px;
    border: 1px solid #919EAB52;
    cursor: pointer;
    mask: unset;
    background-color: transparent;
    transition: .3s;
}

#research-sort .sort .grid span {
	width: 5px;
    height: 7px;
    background-color: #474E54;
    border-radius: 2px;
	transition: .3s;
}

#research-sort .sort .rows {
	display: flex;
    align-items: center;
    justify-content: center;
	flex-direction: column;
	gap: 1.3px;
    min-width: 48px;
    height: 48px;
    border: 1px solid #919EAB52;
	cursor: pointer;
	mask: unset;
	background-color: transparent;
	transition: .3s;
}

#research-sort .sort .rows span {
	width: 100%;
	max-width: 15px;
    min-height: 6px;
    background: #212B36;
    border-radius: 1.5px;
	transition: .3s;
}

#research-sort .sort .rows.active {
	background-color: #49B9E514;
	border: 1px solid #49B9E57A;
}

#research-sort .sort .rows.active span {
	background-color: #49B9E5;
}

#research-sort .sort .grid.active {
	background-color: #49B9E514;
	border: 1px solid #49B9E57A;
	filter: unset;
}

#research-sort .sort .grid.active span {
	background-color: #49B9E5;
}

/*Media 1*/

@media (max-width: 1100px) {
	#research-sort .selects-container {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 840px) {
	#research-sort .selects-container {
		grid-template-columns: 1fr;
	}
}

/*Media 2*/

@media (max-width: 840px) {
	
	#research-sort {
		margin-bottom: 20px;
	}
	
	#research-sort .search-container {
		width: 100%;
	}
	
	#research-sort .filters .column {
		flex: 1;
	}
	
	#research-sort .sort-holder .facetwp-facet {
		margin-bottom: 0px;
	}
	
	#research-sort .filters .facetwp-type-sort {
		margin-bottom: 0px;
	}
	
	#research-sort .search-container {
		margin-bottom: 12px;
	}
	
}

@media (max-width: 767px) {
	
	#research-sort .container {
		padding-top: 40px;
	}
	
	#research-sort .selects-container {
		flex-direction: column;
	}
	
	#research-sort .search-container {
		margin-bottom: 12px;
	}
	
	#research-sort .sort-holder .facetwp-facet {
		margin-bottom: 0px;
	}
	
	#research-sort .selects-container .column {
		width: 100%;
	}
	
	#research-sort .filters {
		gap: 0px;
	}
	
	#research-sort .sort-holder .sort {
		display: none;
	}
}</style><style class="wpcode-css-snippet">#search-container h5 {
	display: none;
}

#search-container .container {
	padding-left: unset !important;
	padding-right: unset !important;
}

#search-container .column {
	padding: unset;
}

#search-container .columns {
	margin-left: unset !important;
	margin-right: unset !important;
}

#search-container {
	position: fixed;
	right: 36px;
	max-width: 713px;
	margin-left: auto;
	border-radius: 4px;
	box-shadow: 0px 12px 24px -4px #919EAB1F;
	overflow: hidden;
}

#search-container.is-open {
	top: 71px;
	position: fixed;
	animation-name: slide-down;
	animation-duration: .75s;
	animation-fill-mode: forwards;
}

@keyframes slide-down {
	0% {
    opacity: 0;
    transform: translateY(-1.6rem);
}

	100% {
			opacity: 1;
			transform: translateY(0);
	}
}

#search-container .holder {
	padding: 4px;
    padding-left: 56px;
	animation: none !important;
	opacity: 1 !important;
	transform: translateY(0) !important;
}

#search-container .search-form {
	display: flex;
    justify-content: space-between;
	align-items: center;
    width: 100%;
}

#search-container .search-form label {
	width: 100%;
}

#search-container .holder::before {
	content: '';
	position: absolute;
	top: 19px;
	left: 24px;
	z-index: 999;
	width: 24px;
	height: 24px;
	background-image: url(/wp-content/uploads/2025/01/icon-search.svg);
	background-repeat: no-repeat;
	background-position: center;
	background-size: cover;
}

#search-container .holder input[type=submit] {
	font-size: 16px;
	background-color: #49B9E5 !important;
	border-color: unset;
	min-height: 54px;
	min-width: 140px;
	border-radius: 4px;
	letter-spacing: 1px;
}

#search-container .holder input[type=search] {
	font-size: 18px;
	font-weight: 400;
	border-bottom: unset;
	top: 2px;
	padding: 0px;
	user-select: none; 
	color: #222222;
	outline: none;
	width: 100%;
}


#search-container .holder input[type=search]::placeholder {
	font-size: 18px;
	font-weight: 400;
	color: #222222;
}

#search-container .holder input[type=submit]:hover {
	background-color: #fff !important;
	border-color: #49B9E5;
	color: #49B9E5;
}


@media (max-width: 767px) {
	#search-container {
	top: 62px;
	max-width: 100%;
    margin: 0 auto;
    left: unset;
    right: unset;
	background: transparent;
	}
	
	#search-container .container {
	margin-right: 10px;
    margin-left: 10px;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0px 12px 24px -4px #919EAB1F;
	}
	
	#search-container .search-form {
		min-width: unset;
	}
	
	#search-container .holder input[type=search] {
		min-width: unset !important;
		font-size: 16px;
		top: 0px;
	}
	

	#search-container .holder input[type=search]::placeholder {
		font-size: 16px;
	}
	
	#search-container.is-open {
		padding-bottom: unset !important;
	}

	#search-container .holder {
		padding-left: 44px;
	}

	#search-container .holder::before {
		top: 15px;
		left: 12px;
	}
	
	#search-container .holder input[type=submit] {
	min-width: 82px;
    min-height: 46px;
    padding: 0;
	font-size: 14px;
}</style><style class="wpcode-css-snippet">.search-results-header {
	padding-top: 100px;
}

@media (max-width: 840px) {
	.search-results-header {
		padding-top: 50px;
	}
}</style><script defer src="data:text/javascript;base64,DQpqUXVlcnkoZG9jdW1lbnQpLnJlYWR5KGZ1bmN0aW9uKCQpIHsNCiAgICAkKCcjc2VhcmNoLWNvbnRhaW5lciAuc2VhcmNoLWZpZWxkJykuYXR0cigicGxhY2Vob2xkZXIiLCAiU2VhcmNoIHRoZSBkYXRhYmFzZS4uLiIpOw0KfSk7"></script><link rel="icon" href="https://rethinkpriorities.org/wp-content/uploads/2024/09/cropped-rethink-priorities-favicon-32x32.png" sizes="32x32" /><link rel="icon" href="https://rethinkpriorities.org/wp-content/uploads/2024/09/cropped-rethink-priorities-favicon-192x192.png" sizes="192x192" /><link rel="apple-touch-icon" href="https://rethinkpriorities.org/wp-content/uploads/2024/09/cropped-rethink-priorities-favicon-180x180.png" /><meta name="msapplication-TileImage" content="https://rethinkpriorities.org/wp-content/uploads/2024/09/cropped-rethink-priorities-favicon-270x270.png" /><style id="wp-custom-css">.excerpt a {
