\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-paper overall ratings (0--100 percentile). \textbf  {(a)} Individual human evaluator midpoints (green circles) with 90\% credible intervals and GPT-5 Pro rating (orange diamond with CI) for each paper, sorted by descending human mean. Dotted lines mark grand means. \textbf  {(b)} Human mean vs LLM overall rating for GPT-5 Pro and Claude Opus 4.6. Dashed diagonal is the identity line (perfect agreement); points above it indicate the LLM rated the paper higher.}}{3}{figure.caption.1}\protected@file@percent }
\newlabel{fig-overview-combined}{{1}{3}{Per-paper overall ratings (0--100 percentile). \textbf {(a)} Individual human evaluator midpoints (green circles) with 90\% credible intervals and GPT-5 Pro rating (orange diamond with CI) for each paper, sorted by descending human mean. Dotted lines mark grand means. \textbf {(b)} Human mean vs LLM overall rating for GPT-5 Pro and Claude Opus 4.6. Dashed diagonal is the identity line (perfect agreement); points above it indicate the LLM rated the paper higher}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Triptych slopegraph of paper rankings (overall criterion). Centre column shows human mean ranking; left and right columns show GPT-5 Pro and Claude Opus 4.6 rankings respectively. Each paper is connected by S-shaped curves; colour intensity encodes the magnitude of rank shift (Δrank). Green = humans rank it higher; warm colour = LLM ranks it higher. Horizontal curves indicate agreement.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig-rankslope-main}{{2}{4}{Triptych slopegraph of paper rankings (overall criterion). Centre column shows human mean ranking; left and right columns show GPT-5 Pro and Claude Opus 4.6 rankings respectively. Each paper is connected by S-shaped curves; colour intensity encodes the magnitude of rank shift (Δrank). Green = humans rank it higher; warm colour = LLM ranks it higher. Horizontal curves indicate agreement}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Human minus LLM rating difference for every paper (columns) and criterion (rows), comparing GPT-5 Pro (left panel) and Claude Opus 4.6 (right panel). Green tiles indicate the human mean was higher; orange tiles indicate the LLM rated the paper higher. Colour is clamped to ±30 percentile points. Papers are sorted by GPT-5 Pro overall difference so the two panels are directly comparable.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig-gap-heatmap-main}{{3}{5}{Human minus LLM rating difference for every paper (columns) and criterion (rows), comparing GPT-5 Pro (left panel) and Claude Opus 4.6 (right panel). Green tiles indicate the human mean was higher; orange tiles indicate the LLM rated the paper higher. Colour is clamped to ±30 percentile points. Papers are sorted by GPT-5 Pro overall difference so the two panels are directly comparable}{figure.caption.3}{}}
