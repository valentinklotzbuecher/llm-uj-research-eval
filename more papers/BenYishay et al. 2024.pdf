         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Irrigation strengthens climate resilience: Long-term evidence from Mali using satellites and surveys</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
